# ============================================================
# IDPS - Intelligent Document Processing System
# Environment Variables Configuration
# Copy this file to .env and fill in your values
# ============================================================

# ─── Application ────────────────────────────────────────────
APP_NAME="IDPS - Intelligent Document Processing System"
VERSION="1.0.0"
PORT=8000
DEBUG=false
SECRET_KEY=your-very-secret-key-change-in-production-min-32-chars

# ─── Database ───────────────────────────────────────────────
# SQLite (default for development)
DATABASE_URL=sqlite+aiosqlite:///./idps.db

# PostgreSQL (recommended for production)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/idps

# ─── File Storage ───────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# ─── OCR Configuration ──────────────────────────────────────
# Path to tesseract binary (default: tesseract in PATH)
TESSERACT_CMD=tesseract
OCR_LANGUAGE=eng
OCR_DPI=300

# ─── NLP Configuration ──────────────────────────────────────
SPACY_MODEL=en_core_web_sm

# ─── CORS Origins ───────────────────────────────────────────
# JSON array of allowed origins
CORS_ORIGINS=["http://localhost:3000","https://your-frontend.vercel.app"]

# ─── Redis (optional, for production task queue) ────────────
# REDIS_URL=redis://localhost:6379/0

# ─── Frontend Environment Variables ─────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# For production (Render/Railway):
# NEXT_PUBLIC_API_URL=https://your-backend.onrender.com
# NEXT_PUBLIC_WS_URL=wss://your-backend.onrender.com

# ─── Optional: Anthropic AI Enhancement ─────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
